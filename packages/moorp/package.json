{
  "name": "moorp",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first visual workspace for code-driven frontend design: an infinite canvas of live Page and Design frames.",
  "license": "MIT",
  "keywords": [
    "frontend",
    "canvas",
    "storybook",
    "design",
    "hmr"
  ],
  "type": "module",
  "bin": {
    "moorp": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --experimental-strip-types src/*.test.ts"
  },
  "dependencies": {
    "@moorp/core": "workspace:*",
    "@moorp/shell": "workspace:*"
  },
  "peerDependencies": {
    "vite": "^5.0.0 || ^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "vite": "^6.0.0"
  }
}
